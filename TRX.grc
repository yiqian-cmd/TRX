    - 0
    - 1040
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable
  parameters:
    comment: RX 手动增益 [XMLRPC 同步]
    value: '40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 1080
    rotation: 0
    state: enabled
- name: zmq_bits_in
  id: zeromq_sub_source
  parameters:
    address: tcp://127.0.0.1:53101
    affinity: ''
    alias: ''
    bind: 'False'
    comment: Python TxWorker packed bytes
    hwm: '-1'
    key: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    pass_tags: 'False'
    timeout: '100'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 80
    - 640
    rotation: 0
    state: enabled
- name: zmq_bits_in_2nd
  id: zeromq_sub_source
  parameters:
    address: tcp://127.0.0.1:53102
    affinity: ''
    alias: ''
    bind: 'False'
    comment: 第二发射源信息波 packed bytes (网页启用后才发流)
    hwm: '-1'
    key: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    pass_tags: 'False'
    timeout: '100'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 80
    - 1120
    rotation: 0
    state: enabled
- name: tx_mod_info_2nd
  id: digital_gfsk_mod
  parameters:
    affinity: ''
    alias: ''
    bt: bt
    comment: 第二发射源信息波 GFSK(固定信息波)
    do_unpack: 'True'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: sps
    sensitivity: 2*3.141592653589793*((info_bw/2)-(samp_rate/sps))/samp_rate
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 1120
    rotation: 0
    state: enabled
- name: tx_mod_info
  id: digital_gfsk_mod
  parameters:
    affinity: ''
    alias: ''
    bt: bt
    comment: 信息波 GFSK, sens≈1.5628
    do_unpack: 'True'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: sps
    sensitivity: 2*3.141592653589793*((info_bw/2)-(samp_rate/sps))/samp_rate
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 480
    rotation: 0
    state: enabled
- name: tx_mod_int1
  id: digital_gfsk_mod
  parameters:
    affinity: ''
    alias: ''
    bt: bt
    comment: 1级干扰 GFSK, sens≈2.8194
    do_unpack: 'True'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: sps
    sensitivity: 2*3.141592653589793*((int1_bw/2)-(samp_rate/sps))/samp_rate
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 640
    rotation: 0
    state: enabled
- name: tx_mod_int2
  id: digital_gfsk_mod
  parameters:
    affinity: ''
    alias: ''
    bt: bt
    comment: 2级干扰 GFSK, sens≈2.5681
    do_unpack: 'True'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: sps
    sensitivity: 2*3.141592653589793*((int2_bw/2)-(samp_rate/sps))/samp_rate
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 800
    rotation: 0
    state: enabled
- name: tx_mod_int3
  id: digital_gfsk_mod
  parameters:
    affinity: ''
    alias: ''
    bt: bt
    comment: 3级干扰 GFSK, sens≈0.6517
    do_unpack: 'True'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: sps
    sensitivity: 2*3.141592653589793*((int3_bw/2)-(samp_rate/sps))/samp_rate
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 960
    rotation: 0
    state: enabled
- name: tx_mod_info_gate
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 信息波门控
    const: tx_mod_info_en
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 600
    - 480
    rotation: 0
    state: enabled
- name: tx_mod_int1_gate
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 1级门控
    const: tx_mod_int1_en
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 600
    - 640
    rotation: 0
    state: enabled
- name: tx_mod_int2_gate
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 2级门控
    const: tx_mod_int2_en
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 600
    - 800
    rotation: 0
    state: enabled
- name: tx_mod_int3_gate
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 3级门控
    const: tx_mod_int3_en
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 600
    - 960
    rotation: 0
    state: enabled
- name: tx_wave_add
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 四路门控波形+第二源信息波 叠加
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '5'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 860
    - 700
    rotation: 0
    state: enabled
- name: nanosdr_sink
  id: iio_pluto_sink
  parameters:
    affinity: ''
    alias: ''
    attenuation1: tx_attenuation1
    bandwidth: samp_rate
    buffer_size: '32768'
    comment: 'Pluto 发射: 频点/衰减由 XMLRPC 实时控制'
    cyclic: 'False'
    filter: ''
    filter_source: '''Auto'''
    fpass: '0'
    frequency: tx_center_freq1
    fstop: '0'
    len_tag_key: ''
    samplerate: samp_rate
    type: fc32
    uri: sdr_uri1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 700
    rotation: 0
    state: enabled
- name: xmlrpc_server
  id: xmlrpc_server
  parameters:
    addr: 0.0.0.0
    alias: ''
    comment: Python 参数同步
    port: '53106'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 80
    - 80
    rotation: 0
    state: enabled
- name: nanosdr_source
  id: iio_pluto_source
  parameters:
    affinity: ''
    alias: ''
    bandwidth: bw
    bbdc: 'True'
    buffer_size: '32768'
    comment: 'Pluto 接收: 频点/增益由 XMLRPC 实时控制'
    filter: ''
    filter_source: '''Auto'''
    fpass: '0'
    frequency: rx_center_freq
    fstop: '0'
    gain1: '''manual'''
    len_tag_key: packet_len
    manual_gain1: rx_gain
    maxoutbuf: '0'
    minoutbuf: '0'
    quadrature: 'True'
    rfdc: 'True'
    samplerate: samp_rate
    type: fc32
    uri: sdr_uri1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 80
    - 1200
    rotation: 0
    state: enabled
- name: rx_int_nco
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1'
    comment: '干扰支路 NCO: 干扰频点-RX中心'
    freq: rx_interfere_channel_freq - rx_center_freq
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 340
    - 1340
    rotation: 0
    state: enabled
- name: rx_int_shift
  id: blocks_multiply_conjugate_cc
  parameters:
    affinity: ''
    alias: ''
    comment: 共轭相乘搬移频谱
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 600
    - 1240
    rotation: 0
    state: enabled
- name: rx_int_filter
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: 信道低通(随 rx_int_bw 自适应)
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_delay: '0'
    taps: rx_int_fir_taps
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 860
    - 1240
    rotation: 0
    state: enabled
- name: rx_int_agc
  id: analog_agc_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 自动增益
    gain: '1.0'
    max_gain: '65536'
    maxoutbuf: '0'
    minoutbuf: '0'
    rate: 1e-5
    reference: '0.5'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 1240
    rotation: 0
    state: enabled
- name: rx_int_quad
  id: analog_quadrature_demod_cf
  parameters:
    affinity: ''
    alias: ''
    comment: FM 鉴频(增益随 rx_int_bw 自适应)
    gain: 1/(2*3.141592653589793*((rx_int_bw/2)-(samp_rate/sps))/samp_rate)
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1380
    - 1240
    rotation: 0
    state: enabled
- name: rx_int_rail
  id: analog_rail_ff
  parameters:
    affinity: ''
    alias: ''
    comment: 限幅 ±1.2
    hi: '1.2'
    lo: '-1.2'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1640
    - 1240
    rotation: 0
    state: enabled
- name: rx_int_gauss
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: 高斯匹配滤波
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_delay: '0'
    taps: firdes.gaussian(1.0, sps, bt, int(3*sps) + 1)
    type: fff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1900
    - 1320
    rotation: 0
    state: enabled
- name: rx_int_dc_iir
  id: single_pole_iir_filter_xx
  parameters:
    affinity: ''
    alias: ''
    alpha: 1e-8
    comment: 慢速IIR跟踪直流
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1900
    - 1420
    rotation: 0
    state: enabled
- name: rx_int_dc_cancel
  id: blocks_sub_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 去直流
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1640
    - 1400
    rotation: 0
    state: enabled
- name: rx_int_sync
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
