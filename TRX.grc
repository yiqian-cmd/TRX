    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 680
    rotation: 0
    state: enabled
- name: tx_attenuation2
  id: variable
  parameters:
    comment: 第二发射衰减 dB [XMLRPC 同步]
    value: '60'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 720
    rotation: 0
    state: enabled
- name: tx_mod_info_en
  id: variable
  parameters:
    comment: 信息波门控 [XMLRPC 同步]
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 760
    rotation: 0
    state: enabled
- name: tx_mod_int1_en
  id: variable
  parameters:
    comment: 1级干扰门控 [XMLRPC 同步]
    value: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 800
    rotation: 0
    state: enabled
- name: tx_mod_int2_en
  id: variable
  parameters:
    comment: 2级干扰门控 [XMLRPC 同步]
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 840
    rotation: 0
    state: enabled
- name: tx_mod_int3_en
  id: variable
  parameters:
    comment: 3级干扰门控 [XMLRPC 同步]
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 880
    rotation: 0
    state: enabled
- name: rx_center_freq
  id: variable
  parameters:
    comment: RX 中心频点 [XMLRPC 同步]
    value: '432200000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 920
    rotation: 0
    state: enabled
- name: rx_interfere_channel_freq
  id: variable
  parameters:
    comment: 干扰支路频点 [XMLRPC 同步]
    value: '432200000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 960
    rotation: 0
    state: enabled
- name: rx_info_channel_freq
  id: variable
  parameters:
    comment: 信息支路频点 [XMLRPC 同步]
    value: '433200000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 1000
    rotation: 0
    state: enabled
- name: rx_int_bw
  id: variable
