options:
  parameters:
    author: RMUC2026-NC
    catch_exceptions: 'True'
    category: '[RMUC2026-NC]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Full-wave single-NanoSDR loopback. TX: ZMQ(53101) -> 4 parallel
      GFSK modulators (info 540kHz@1.5628, int1 940kHz@2.8194, int2 860kHz@2.5681,
      int3 250kHz@0.6517) with web-controlled gates -> 4-input add -> Pluto Sink.
      RX: Pluto Source -> dual NCO branches: interfere branch (auto-adapting bw/gain
      via rx_int_bw) -> ZMQ 53104, info branch (540kHz) -> ZMQ 53103. XMLRPC server
      on 53106.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: TRX
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: TRX 全波形收发回环 - 单台Pluto (信息波+红方1/2/3级干扰波+第二源信息波)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 采样率 1 MHz
    value: '1000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 0
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: 每符号采样数
    value: '47'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 40
    rotation: 0
    state: enabled
- name: bt
  id: variable
  parameters:
    comment: GFSK BT
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 80
    rotation: 0
    state: enabled
- name: bw
  id: variable
  parameters:
    comment: Pluto 模拟射频带宽
    value: '1000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 120
    rotation: 0
    state: enabled
- name: loop_bw
  id: variable
  parameters:
    comment: 符号同步环带宽
    value: '0.005'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 160
    rotation: 0
    state: enabled
- name: Time_Sink_Number
  id: variable
  parameters:
    comment: ''
    value: '200'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 200
    rotation: 0
    state: enabled
- name: sdr_uri1
  id: variable
  parameters:
    comment: 本机 SDR 的 IP（按实际修改）
    value: '''ip:192.168.2.1'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 240
    rotation: 0
    state: enabled
- name: info_bw
  id: variable
  parameters:
    comment: 信息波带宽(规则表5-23)
    value: '540000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 280
    rotation: 0
    state: enabled
- name: int1_bw
  id: variable
  parameters:
    comment: 红方1级干扰带宽
    value: '940000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 320
    rotation: 0
    state: enabled
- name: int2_bw
  id: variable
  parameters:
    comment: 红方2级干扰带宽
    value: '860000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 360
    rotation: 0
    state: enabled
- name: int3_bw
  id: variable
  parameters:
    comment: 红方3级干扰带宽
    value: '250000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 400
    rotation: 0
    state: enabled
- name: rx_info_bw
  id: variable
  parameters:
    comment: 信息支路带宽
    value: '540000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 440
    rotation: 0
    state: enabled
- name: rx_int_fir_taps
  id: variable
  parameters:
    comment: 干扰支路信道滤波抽头(自适应)
    value: firdes.low_pass(1, samp_rate, rx_int_bw / 2, 20000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 520
    rotation: 0
    state: enabled
- name: rx_info_fir_taps
  id: variable
  parameters:
    comment: 信息支路信道滤波抽头
    value: firdes.low_pass(1, samp_rate, rx_info_bw / 2, 20000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 560
    rotation: 0
    state: enabled
- name: tx_center_freq1
  id: variable
  parameters:
    comment: 主发射频点(随网页波形自动切换) [XMLRPC 同步]
    value: '432200000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 600
    rotation: 0
    state: enabled
- name: tx_center_freq2
  id: variable
